{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "serial-tool",
  "version": "1.1.0",
  "identifier": "com.xhj.serialtool",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "串口调试工具(作者:心情)",
        "width": 1000,
        "height": 680,
        "minWidth": 760,
        "minHeight": 520,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu --disable-gpu-compositing"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
